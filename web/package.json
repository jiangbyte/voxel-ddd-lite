{
  "name": "voxel-web",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:portal": "pnpm --filter @voxel/portal dev",
    "dev:admin": "pnpm --filter @voxel/admin dev",
    "build:portal": "pnpm --filter @voxel/portal build",
    "build:admin": "pnpm --filter @voxel/admin build",
    "build": "pnpm -r --filter @voxel/shared --filter @voxel/portal --filter @voxel/admin run build",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
